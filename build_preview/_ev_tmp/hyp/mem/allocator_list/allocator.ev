module allocator_list

subscribe allocator_add_ram_range(owner, virt_base, size, attr)
	priority last

subscribe allocator_remove_ram_range(owner, virt_base, size, attr)
	priority last

subscribe allocator_range_is_free(owner, virt_base, size, attr)
	priority last
