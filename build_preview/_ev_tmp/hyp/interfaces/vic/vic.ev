interface vic

handled_event vic_bind_virq
	param irq_obj_cap: cap_id_t
	param vic: vic_t *
	param index: index_t
	param virq: virq_t
	return: error_t = ERROR_CSPACE_WRONG_OBJECT_TYPE

selector_event vic_bind_hwirq
	selector action: hwirq_action_t
	param vic: vic_t *
	param hwirq: hwirq_t *
	param virq: virq_t
	return: error_t = ERROR_ARGUMENT_INVALID

handled_event vic_unbind_virq
	param irq_obj_cap: cap_id_t
	param index: index_t
	return: error_t = ERROR_CSPACE_WRONG_OBJECT_TYPE

selector_event vic_unbind_hwirq
	selector action: hwirq_action_t
	param hwirq: hwirq_t *
	return: error_t = ERROR_ARGUMENT_INVALID

handled_event vic_bind_msi_source
	param vic: vic_t *
	param msi_source_cap: cap_id_t
	param source_config: vic_msi_source_config_t
	return: error_t = ERROR_CSPACE_WRONG_OBJECT_TYPE
