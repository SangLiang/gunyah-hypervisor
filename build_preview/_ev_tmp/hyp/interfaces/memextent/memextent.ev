	param me: memextent_t *
	param pa: paddr_t
	param size: size_t
	return: size_result_t = size_result_error(ERROR_MEMEXTENT_TYPE)

handled_event memextent_set_sanitise_on_reset
	param extent: memextent_t *
	param phys: paddr_t
	param size: size_t
