module preempt

subscribe boot_cpu_early_init

subscribe boot_cpu_start
	priority last

subscribe thread_start
	priority first

subscribe thread_entry_from_user
	priority last

subscribe thread_exit_to_user
	priority first


subscribe scheduler_stop()
	priority first
